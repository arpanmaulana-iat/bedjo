  "pesan": [
    { "id": "p1", "label": "Barakallahu fiik", "text": "Barakallahu fiik. Semoga langkah menuju skripsi dimudahkan, dan setiap ayat yang kau kaji menjadi cahaya bagi hidupmu." },
    { "id": "p2", "label": "Dilancarkan penelitiannya", "text": "Selamat atas selesainya ujian proposal! Semoga Allah mudahkan penelitianmu, diluaskan sabarmu, dan diberkahi setiap prosesnya." },
    { "id": "p3", "label": "Menuju gelar S.Ag.", "text": "Satu babak telah dilewati. Semoga bab-bab berikutnya mengalir tenang, dan gelar S.Ag. segera menyusul. Aamiin." },
    { "id": "p4", "label": "Mabruk, terus menghidupkan Al-Qur'an", "text": "Mabruk! Lelahmu hari ini adalah taburan cahaya untuk masa depan. Teruslah membaca, meneliti, dan menghidupkan Al-Qur'an." },
    { "id": "p5", "label": "Doa untuk tahap selanjutnya", "text": "Selamat berjuang di tahap selanjutnya. Semoga Allah menjaga niatmu, meluaskan sabarmu, dan meridhai ikhtiarmu." }
